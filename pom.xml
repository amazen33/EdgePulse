<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.edgepulse.platform</groupId>
  <artifactId>edgepulse-platform-parent</artifactId>
  <version>2.0.0</version>
  <packaging>pom</packaging>

  <name>EdgePulse Platform (parent)</name>
  <description>
    Maven multi-module parent for the Java platform per ADR 0011
    (platform architecture and language stack), ADR 0012 (M9 foundation
    scope, Track B), and ADR 0013 (microservice autonomy and
    contract-based sharing). Per ADR 0013, this parent deliberately has
    no shared-runtime module: "common/" and "adapters/web-spring/" (M9's
    first Track B attempt) do not exist here. Contract sources live at
    the repository root under contracts/ (proto and JSON Schema files
    only, no generated-code jar); architecture/ holds shared ArchUnit
    rule definitions, consumed at test scope only; each services/*
    module owns its own domain, RBAC, correlation, and Spring wiring
    code, generating its own Protobuf classes from contracts/ as part of
    its own build. The frozen M0-M8 Python reference implementation is
    archived in tag archive/python-spec-final; ADR 0012 Decision 8 still
    applies to it.
  </description>

  <modules>
    <module>architecture</module>
    <module>services/identity</module>
    <module>contract-tests</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <!-- Test JVM startup instrumentation; late evaluation also preserves a
         future coverage agent without changing application/runtime arguments. -->
    <argLine></argLine>
    <spring-boot.version>4.1.2</spring-boot.version>
    <!-- ADR 0027; IOT-WO-06 rulings 2026-10-21: import Log4j's BOM first,
         using direct artifacts without the unsupported Boot logging starter.
         Part C must re-evaluate this override with the Spring line upgrade. -->
    <log4j2.version>2.26.1</log4j2.version>
    <archunit.version>1.3.0</archunit.version>
    <protobuf.version>3.25.9</protobuf.version>
    <protobuf-maven-plugin.version>0.6.1</protobuf-maven-plugin.version>
    <!-- IOT-WO-08: gRPC-Java 1.84.0's published grpc-protobuf POM requires
         protobuf-java 3.25.9. Keep the runtime and protoc aligned on that
         supported Java maintenance line; no Spring or Java line change. -->
    <grpc.version>1.84.0</grpc.version>
    <!-- Required at compile time by grpc-java generated stubs on Java 9+
         (javax.annotation.Generated), per grpc-java's own README. -->
    <tomcat-annotations-api.version>6.0.53</tomcat-annotations-api.version>
    <!-- Streaming and data plane (ADR 0019). Flink 1.20.x is the 1.x LTS
         line and the only one with a current release of BOTH connectors
         below (flink.apache.org/downloads: Kafka connector 3.4.0 -> 1.20.x,
         Elasticsearch connector 3.1.0 -> 1.18-1.20.x; the 2.x line has no
         Elasticsearch connector past 2.0). Connectors are released on their
         own cadence, versioned <connector>-<flink minor>, so they do NOT
         follow flink.version: bump all three together, and re-check the
         downloads page's compatibility table when you do. -->
    <flink.version>1.20.5</flink.version>
    <flink-connector-kafka.version>3.4.0-1.20</flink-connector-kafka.version>
    <flink-connector-elasticsearch.version>3.1.0-1.20</flink-connector-elasticsearch.version>
    <json-schema-validator.version>1.5.1</json-schema-validator.version>
    <cloudevents.version>3.0.0</cloudevents.version>
    <junit.version>5.10.3</junit.version>
    <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>
    <maven-invoker-plugin.version>3.7.0</maven-invoker-plugin.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!-- IOT-WO-08: an existing legacy annotation API stays unchanged. -->
      <dependency>
        <groupId>jakarta.annotation</groupId>
        <artifactId>jakarta.annotation-api</artifactId>
        <version>2.1.1</version>
      </dependency>
      <!-- IOT-WO-08 clarification 2026-10-21: Error Prone has a real enum;
           preserve the exact already-admitted legacy annotation artifact
           and fingerprint instead of excluding or re-qualifying it. -->
      <dependency>
        <groupId>com.google.errorprone</groupId>
        <artifactId>error_prone_annotations</artifactId>
        <version>2.28.0</version>
      </dependency>
      <!-- Part C trial: Spring Boot 4.1's BOM would move these already
           admitted runtime components; keep their admitted versions and
           fingerprints (no new ADR-0054 record needed for an unchanged one). -->
      <dependency>
        <groupId>com.google.code.gson</groupId>
        <artifactId>gson</artifactId>
        <version>2.10.1</version>
      </dependency>
      <dependency>
        <groupId>com.google.j2objc</groupId>
        <artifactId>j2objc-annotations</artifactId>
        <version>1.3</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>2.0.16</version>
      </dependency>
      <!-- Part C trial: Boot 4 requires Servlet 6.1; use its tested
           Tomcat 11 BOM rather than the old Boot 3/Tomcat 10 overrides. -->
      <!-- Test classpaths only; no logging-backend or service change. -->
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>3.27.7</version>
      </dependency>
      <dependency>
        <groupId>net.minidev</groupId>
        <artifactId>json-smart</artifactId>
        <version>2.5.2</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>1.5.38</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-core</artifactId>
        <version>1.5.38</version>
      </dependency>
      <dependency>
        <groupId>org.apache.logging.log4j</groupId>
        <artifactId>log4j-bom</artifactId>
        <version>${log4j2.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- gRPC runtime for services that expose a gRPC driving adapter
           (ADR 0017 Decision 3). An ordinary third-party dependency each
           service declares for itself (ADR 0013 Decision 2); the BOM
           only pins versions, it adds nothing to any classpath.
           Imported BEFORE Spring Boot's BOM (Part C trial): Boot 4.1 also
           manages gRPC, and the first import wins, so grpc.version stays
           the admitted 1.84.0. -->
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.tomcat</groupId>
        <artifactId>annotations-api</artifactId>
        <version>${tomcat-annotations-api.version}</version>
        <scope>provided</scope>
      </dependency>

      <!-- ================= Streaming and data plane =================
           Version management only: no module uses these yet, and Maven
           resolves a dependencyManagement entry only when a module
           declares the dependency, so nothing is downloaded until then.

           Flink core APIs are PROVIDED: the Flink cluster already has them
           on its classpath, so they must stay out of the job JAR (Flink
           docs, "Project configuration": flink-streaming-java and
           flink-clients are not bundled). Connectors are the opposite:
           they are NOT part of the Flink binary distribution and must be
           packaged into the job's uber JAR, so they keep the default
           (compile) scope here. Marking a connector provided makes the
           job fail at runtime with ClassNotFoundException. -->
      <dependency>
        <groupId>org.apache.flink</groupId>
        <artifactId>flink-streaming-java</artifactId>
        <version>${flink.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.flink</groupId>
        <artifactId>flink-clients</artifactId>
        <version>${flink.version}</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <!-- Version only; the first job module decides its scope. -->
        <groupId>org.apache.flink</groupId>
        <artifactId>flink-connector-base</artifactId>
        <version>${flink.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.flink</groupId>
        <artifactId>flink-connector-kafka</artifactId>
        <version>${flink-connector-kafka.version}</version>
      </dependency>
      <!-- Elasticsearch sink connectors. NOTE: no accepted ADR places an
           Elasticsearch store in the platform yet (ADR 0019: Flink ->
           redaction -> pgvector; ADR 0015: logs go to LGTM/Loki). Kept
           at the repository owner's request (2026-09-25); an ADR must
           land before any module depends on these. -->
      <dependency>
        <groupId>org.apache.flink</groupId>
        <artifactId>flink-connector-elasticsearch7</artifactId>
        <version>${flink-connector-elasticsearch.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.flink</groupId>
        <artifactId>flink-connector-elasticsearch8</artifactId>
        <version>${flink-connector-elasticsearch.version}</version>
      </dependency>
      <!-- Elasticsearch Java client and Spring Data Elasticsearch are
           ALREADY managed centrally by the spring-boot-dependencies BOM
           imported above (Spring Boot 3.3.4 pins co.elastic.clients:
           elasticsearch-java and org.elasticsearch.client:
           elasticsearch-rest-client to 8.13.4, and spring-data-
           elasticsearch through its spring-data-bom). They are
           deliberately not redeclared: a second entry here would fork
           from Spring Boot's tested set. Bump them by bumping
           spring-boot.version.

           Known interaction for the first Flink job module: because this
           parent imports the Spring Boot BOM, Spring Boot's pinned
           kafka-clients and elasticsearch-java versions also apply
           there, overriding the versions the Flink connectors were built
           against (flink-connector-kafka 3.4.0 builds with kafka-clients
           3.4.0). Decide in that module whether to accept the override or
           pin the connector's own client version; do not decide it
           here, before any job exists to test against. -->

      <!-- The ONE intra-repo artifact any service is ever allowed to depend
           on, and only at test scope (ADR 0013 Decision 8): shared ArchUnit
           rule definitions. No other com.edgepulse.platform:* artifact is
           declared here ; there is no shared runtime module to declare
           (ADR 0013 retires common/ and adapters/web-spring/ outright; see
           this pom's own description and the enforce-no-shared-runtime
           Enforcer rule below, which makes this permanent, not just true
           today because nothing has been added back yet). -->
      <dependency>
        <groupId>com.edgepulse.platform</groupId>
        <artifactId>edgepulse-architecture</artifactId>
        <version>${project.version}</version>
        <scope>test</scope>
      </dependency>

      <!-- Protobuf runtime for CloudEvents-shaped envelope classes each
           service generates for itself from contracts/ (ADR 0012 Decision
           4; ADR 0013 Decision 2/9) ; an ordinary third-party dependency
           every service declares independently, never a project-authored
           shared library. -->
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <!-- Part C trial: Spring Boot 4.1's BOM manages protobuf-java-util at
           4.x, which would split the protobuf family (util 4.x needs the 4.x
           runtime). Keep it on the same version as protobuf-java. -->
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java-util</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>io.cloudevents</groupId>
        <artifactId>cloudevents-protobuf</artifactId>
        <version>${cloudevents.version}</version>
      </dependency>
      <dependency>
        <groupId>io.cloudevents</groupId>
        <artifactId>cloudevents-core</artifactId>
        <version>${cloudevents.version}</version>
      </dependency>

      <!-- cfg.yaml draft JSON Schema validation (ADR 0012 Decision 3) ;
           also an ordinary third-party library, per ADR 0013 Decision 2. -->
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${json-schema-validator.version}</version>
      </dependency>

      <!-- ArchUnit: the Java analog of the mechanical boundary gate in
           archive/python-spec-final:spec/scripts/check.py.
           A standard third-party testing library (ADR 0013
           Decision 2), not project-authored logic ; architecture/'s OWN
           code (the rule factories) is the project-authored, shareable
           part, and it is shareable only because it is a build-time
           architecture-rule artifact, per ADR 0013's own definition of
           what may be shared. -->
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
        <scope>test</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <!-- Every module gets JUnit 5 + ArchUnit for the boundary gate, without repeating scope/version -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
          <dependencies>
            <dependency>
              <groupId>org.codehaus.plexus</groupId>
              <artifactId>plexus-utils</artifactId>
              <version>4.1.0</version>
            </dependency>
          </dependencies>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.5.0</version>
          <dependencies>
            <dependency>
              <groupId>org.codehaus.plexus</groupId>
              <artifactId>plexus-utils</artifactId>
              <version>3.6.2</version>
            </dependency>
          </dependencies>
        </plugin>
        <!-- IOT-WO-02 Amendment 5: collector tools are gated build tools. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.11.0</version>
          <dependencies>
            <dependency>
              <groupId>commons-beanutils</groupId>
              <artifactId>commons-beanutils</artifactId>
              <version>1.11.0</version>
            </dependency>
          </dependencies>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-help-plugin</artifactId>
          <version>3.5.2</version>
          <dependencies>
            <dependency>
              <groupId>org.jsoup</groupId>
              <artifactId>jsoup</artifactId>
              <version>1.23.2</version>
            </dependency>
          </dependencies>
        </plugin>
        <plugin>
          <groupId>org.cyclonedx</groupId>
          <artifactId>cyclonedx-maven-plugin</artifactId>
          <version>2.9.3</version>
          <dependencies>
            <dependency>
              <groupId>org.cyclonedx</groupId>
              <artifactId>cyclonedx-core-java</artifactId>
              <version>11.0.1</version>
            </dependency>
            <dependency>
              <groupId>com.fasterxml.jackson.core</groupId>
              <artifactId>jackson-core</artifactId>
              <version>2.18.11</version>
            </dependency>
            <dependency>
              <groupId>com.fasterxml.jackson.core</groupId>
              <artifactId>jackson-databind</artifactId>
              <version>2.18.11</version>
            </dependency>
            <dependency>
              <groupId>com.fasterxml.jackson.core</groupId>
              <artifactId>jackson-annotations</artifactId>
              <version>2.18.11</version>
            </dependency>
            <dependency>
              <groupId>com.fasterxml.jackson.dataformat</groupId>
              <artifactId>jackson-dataformat-xml</artifactId>
              <version>2.18.11</version>
            </dependency>
          </dependencies>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.xolstice.maven.plugins</groupId>
          <artifactId>protobuf-maven-plugin</artifactId>
          <version>${protobuf-maven-plugin.version}</version>
          <!-- Amendment 5: retain the generator; patch its build-only realm. -->
          <dependencies>
            <dependency>
              <groupId>org.apache.maven</groupId>
              <artifactId>maven-core</artifactId>
              <version>3.9.11</version>
            </dependency>
            <dependency>
              <groupId>org.apache.maven</groupId>
              <artifactId>maven-compat</artifactId>
              <version>3.9.11</version>
            </dependency>
            <dependency>
              <groupId>org.codehaus.plexus</groupId>
              <artifactId>plexus-utils</artifactId>
              <version>3.6.2</version>
            </dependency>
          </dependencies>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- ADR 0013 Decision 5.1 + Decision 8: mechanical, platform-wide
           enforcement that no module ever declares a compile-,
           runtime-, provided-, or system-scope dependency on another com.edgepulse.platform:*
           artifact. This is what makes "no shared runtime module" a
           build failure, not a convention ; it applies to every module
           via plugin inheritance (declared directly under <plugins>, not
           <pluginManagement>, so it is not opt-in per module) and governs
           every services/*, adapters/*, or future module the same way,
           automatically, without each module's own pom.xml having to
           remember to add it. edgepulse-architecture is exempt only at test
           scope (the version above is pinned with <scope>test</scope>;
           this rule bans compile/runtime scope specifically, so a
           test-scope architecture dependency is unaffected, while a
           compile-scope one ; exactly Decision 8's "architecture/ must
           stay test-scope" rule ; fails the build here). -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <version>${maven-enforcer-plugin.version}</version>
        <executions>
          <execution>
            <id>enforce-contract-tests-not-consumable</id>
            <goals><goal>enforce</goal></goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>com.edgepulse.platform:edgepulse-contract-tests</exclude>
                  </excludes>
                  <message>IOT-WO-03 Amendment 1: contract-tests is a test-only reactor module; no module may depend on it in any scope.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>enforce-no-shared-runtime</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>com.edgepulse.platform:*:*:*:compile</exclude>
                    <exclude>com.edgepulse.platform:*:*:*:runtime</exclude>
                    <exclude>com.edgepulse.platform:*:*:*:provided</exclude>
                    <exclude>com.edgepulse.platform:*:*:*:system</exclude>
                  </excludes>
                  <message>
                    ADR 0013 (microservice autonomy and contract-based
                    sharing) prohibits any compile-, runtime-, provided-,
                    or system-scope dependency on another
                    com.edgepulse.platform:* artifact. Services share
                    contract sources (contracts/) and build-time
                    architecture rules (architecture/, test scope only)
                    -- never a shared runtime library. If you are trying
                    to reuse code across services, that code belongs in
                    each service's own source tree (duplicated, per ADR
                    0013 Decision 6), not in a new shared module.
                  </message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
          <!-- ADR 0017 Decision 4 (per-adapter vendor bans), dependency-
               declaration half. DISABLED BY DEFAULT, on purpose: no
               service declares a ThingsBoard or Kafka client today, so
               this rule would pass vacuously and prove nothing, and the
               day the FIRST real adapter lands it has to allow exactly
               that adapter's module while still banning everyone else,
               which cannot be expressed until that module exists.
               Enable it (remove this comment wrapper) in the same PR
               that adds the first TB CE or Kafka adapter, scoped with an
               <includes> exception for that adapter's own artifact. The
               source-level half of the same ban is already live as
               ArchUnit rules in each service's own test tree (see
               services/identity IdentityFrameworkFreedomArchitectureRulesTest).
          <execution>
            <id>enforce-no-vendor-sdk-outside-adapters</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.thingsboard:*</exclude>
                    <exclude>org.apache.kafka:*</exclude>
                  </excludes>
                  <message>
                    ADR 0017 Decision 4: vendor SDKs are confined to their
                    own adapter module.
                  </message>
                </bannedDependencies>
              </rules>
              <fail>true</fail>
            </configuration>
          </execution>
          -->
        </executions>
      </plugin>
    </plugins>
  </build>

  <!-- S3: opt-in negative test proving the enforce-no-shared-runtime
       Enforcer rule above actually fails a build, not merely that it
       has never fired. NOT active by default; it runs a nested,
       standalone Maven build (architecture/enforcer-negative-fixture/)
       via maven-invoker-plugin, which needs network access to resolve
       its own dependencies the first time it runs in an environment
       without it cached, and a negative test that runs on every
       ordinary "mvn verify" would also slow down and complicate the
       default build for something that, by construction, only needs
       re-proving when the Enforcer rule's own configuration changes.
       Run explicitly with:
         mvn -f pom.xml verify -PenforcerNegativeTest
       CI (or a human reviewer) should run this at least once to close
       S3 before treating the Enforcer rule as proven, not merely
       configured; see architecture/enforcer-negative-fixture/pom.xml
       and verify.groovy for what it actually asserts. -->
  <profiles>
    <profile>
      <id>enforcerNegativeTest</id>
      <activation>
        <property>
          <name>enforcerNegativeTest</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-invoker-plugin</artifactId>
            <version>${maven-invoker-plugin.version}</version>
            <configuration>
              <projectsDirectory>architecture</projectsDirectory>
              <cloneProjectsTo>${project.build.directory}/enforcer-negative-fixture-it</cloneProjectsTo>
              <pomIncludes>
                <pomInclude>enforcer-negative-fixture/pom.xml</pomInclude>
              </pomIncludes>
              <streamLogsOnFailures>true</streamLogsOnFailures>
              <postBuildHookScript>verify</postBuildHookScript>
            </configuration>
            <executions>
              <execution>
                <id>run-enforcer-negative-fixture</id>
                <phase>verify</phase>
                <goals>
                  <goal>install</goal>
                  <goal>run</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
