<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.edgepulse.platform</groupId>
    <artifactId>edgepulse-platform-parent</artifactId>
    <version>2.0.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>edgepulse-service-identity</artifactId>
  <packaging>jar</packaging>
  <name>EdgePulse Platform :: services :: identity</name>
  <description>
    Walking skeleton (ADR 0012 Decision 6), rebuilt per ADR 0013
    (microservice autonomy and contract-based sharing) and laid out per
    ADR 0017 (hexagonal conventions, Track C step C1): domain/ and rbac/
    hold framework-free business rules; port/in and port/out are the
    inbound use-case and outbound dependency interfaces; application/
    implements the inbound ports; adapter/in/rest (Spring MVC) and
    adapter/in/grpc (grpc-java) are two driving adapters over the SAME
    inbound port; adapter/out/persistence holds the in-memory stand-in
    for the future Postgres adapter; config/ is the Spring composition
    root. Envelope and identity gRPC classes are generated by this
    module's own protobuf-maven-plugin executions from contracts/ (ADR
    0013 Decision 9), never from a shared jar. See README.md in this
    module for scope and verification status, and the root pom.xml's
    enforce-no-shared-runtime Enforcer rule for the mechanical guarantee
    that no services/* module can reintroduce a shared runtime artifact.
  </description>

  <dependencies>
    <!-- ADR 0027; IOT-WO-06 ruling 2026-10-21: no Boot Log4j starter.
         The Log4j BOM manages this one backend; no reverse SLF4J bridges. -->
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-slf4j2-impl</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-core</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.logging.log4j</groupId>
      <artifactId>log4j-jul</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
        <!-- IOT-WO-08 annotation-only ruling: exact 1.0.1 JAR checked. -->
        <exclusion><groupId>org.jspecify</groupId><artifactId>jspecify</artifactId></exclusion>
      </exclusions>
    </dependency>

    <!-- Protobuf/CloudEvents runtime for this service's OWN generated
         Envelope classes (see the protobuf-maven-plugin configuration
         below) ; an ordinary third-party dependency, per ADR 0013
         Decision 2, not a project-authored shared library. -->
    <dependency>
      <groupId>com.google.protobuf</groupId>
      <artifactId>protobuf-java</artifactId>
    </dependency>
    <dependency>
      <groupId>io.cloudevents</groupId>
      <artifactId>cloudevents-protobuf</artifactId>
    </dependency>
    <dependency>
      <groupId>io.cloudevents</groupId>
      <artifactId>cloudevents-core</artifactId>
    </dependency>

    <!-- cfg.yaml validation against contracts/cfg/cfg.schema.json (ADR
         0012 Decision 3) ; this service validates its own
         configuration directly against the shared contract file; no
         shared validation library is involved. -->
    <dependency>
      <groupId>com.networknt</groupId>
      <artifactId>json-schema-validator</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- JWT signature verification (adapter.out.jwt.NimbusTokenSignatureVerifier
         only; IdentityFrameworkFreedomArchitectureRulesTest's vendor-SDK
         denylist confines com.nimbusds to that one package, ADR 0016 Decision
         5 / the identity ADR's rejected "hand-written JWT signature
         verification"). The imported BOM does not manage this direct
         dependency. Pin 9.37.4, the patched 9.x release for
         CVE-2025-53864; review it with every dependency upgrade. -->
    <dependency>
      <groupId>com.nimbusds</groupId>
      <artifactId>nimbus-jose-jwt</artifactId>
      <version>9.37.4</version>
    </dependency>

    <!-- gRPC driving adapter (adapter.in.grpc, ADR 0017 Decision 3).
         Versions come from the grpc-bom imported by the parent pom.
         grpc-netty-shaded is the server transport, runtime only: code
         compiles against io.grpc.* API types, never against Netty. -->
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-api</artifactId>
      <!-- IOT-WO-08 ruling 2026-10-21: annotation-only JSpecify is not
           needed at runtime. Exclude on every gRPC/Guava entry path. -->
      <exclusions>
        <exclusion><groupId>org.jspecify</groupId><artifactId>jspecify</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-stub</artifactId>
      <exclusions>
        <exclusion><groupId>org.jspecify</groupId><artifactId>jspecify</artifactId></exclusion>
        <exclusion><groupId>org.codehaus.mojo</groupId><artifactId>animal-sniffer-annotations</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-protobuf</artifactId>
      <exclusions>
        <exclusion><groupId>org.jspecify</groupId><artifactId>jspecify</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty-shaded</artifactId>
      <scope>runtime</scope>
      <exclusions>
        <exclusion><groupId>org.jspecify</groupId><artifactId>jspecify</artifactId></exclusion>
        <exclusion><groupId>org.codehaus.mojo</groupId><artifactId>animal-sniffer-annotations</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <!-- javax.annotation.Generated for grpc-java generated stubs on
           Java 9+ (grpc-java README); compile-time only. -->
      <groupId>org.apache.tomcat</groupId>
      <artifactId>annotations-api</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- ADR 0013 Decision 8: the one intra-repo artifact this service
         may depend on, and only at test scope. Provides this service's
         own architecture test with reusable ArchRule factories; this
         service's own fixtures and test methods still live here, in
         its own test tree. -->
    <dependency>
      <groupId>com.edgepulse.platform</groupId>
      <artifactId>edgepulse-architecture</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
        <!-- IOT-WO-08 annotation-only ruling: exact 1.0.1 JAR checked. -->
        <exclusion><groupId>org.jspecify</groupId><artifactId>jspecify</artifactId></exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <!-- In-process gRPC transport for adapter and transport-equivalence
           tests: real gRPC serialization and dispatch, no network port. -->
      <groupId>io.grpc</groupId>
      <artifactId>grpc-inprocess</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion><groupId>org.jspecify</groupId><artifactId>jspecify</artifactId></exclusion>
        <exclusion><groupId>org.codehaus.mojo</groupId><artifactId>animal-sniffer-annotations</artifactId></exclusion>
      </exclusions>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <!-- Test evidence uses the actual runtime graph, without JUnit/Mockito. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <!-- Java 21: use the already-resolved test agent at JVM startup.
                 No hard-coded repository path or duplicate artifact version. -->
            <id>identity-test-agent-properties</id>
            <phase>initialize</phase>
            <goals><goal>properties</goal></goals>
          </execution>
          <execution>
            <id>identity-runtime-classpath</id>
            <phase>generate-test-resources</phase>
            <goals><goal>build-classpath</goal></goals>
            <configuration>
              <includeScope>runtime</includeScope>
              <outputFile>${project.build.directory}/runtime-classpath.txt</outputFile>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>@{argLine} -javaagent:"${net.bytebuddy:byte-buddy-agent:jar}"</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <!-- ADR 0013 Decision 9: this service generates its OWN Envelope
             classes from the shared contracts/events/v1/envelope.proto
             source, as part of its own build, into its own
             target/generated-sources ; never from a shared jar. A
             future second service needing the same envelope repeats
             this exact plugin configuration against the same .proto
             file; it never adds a dependency on this service's jar. -->
        <groupId>org.xolstice.maven.plugins</groupId>
        <artifactId>protobuf-maven-plugin</artifactId>
        <configuration>
          <protocArtifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protocArtifact>
        </configuration>
        <executions>
          <!-- The event envelope (ADR 0012 Decision 4). Unchanged output
               location: target/generated-sources/protobuf/java. -->
          <execution>
            <id>events-v1</id>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <protoSourceRoot>${project.basedir}/../../contracts/events/v1</protoSourceRoot>
            </configuration>
          </execution>
          <!-- The identity gRPC contract (ADR 0017 Decision 3), in two
               executions on purpose: an execution-level outputDirectory
               applies to every goal in that execution, and each goal
               clears its own output directory first, so putting compile
               and compile-custom in one execution with one directory
               would let the second goal wipe the first goal's output.
               Messages go to generated-sources/protobuf/identity-java;
               grpc-java stubs go to compile-custom's default,
               generated-sources/protobuf/grpc-java. -->
          <execution>
            <id>identity-v1-messages</id>
            <goals>
              <goal>compile</goal>
            </goals>
            <configuration>
              <protoSourceRoot>${project.basedir}/../../contracts/identity/v1</protoSourceRoot>
              <outputDirectory>${project.build.directory}/generated-sources/protobuf/identity-java</outputDirectory>
            </configuration>
          </execution>
          <execution>
            <id>identity-v1-grpc</id>
            <goals>
              <goal>compile-custom</goal>
            </goals>
            <configuration>
              <protoSourceRoot>${project.basedir}/../../contracts/identity/v1</protoSourceRoot>
              <pluginId>grpc-java</pluginId>
              <pluginArtifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</pluginArtifact>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
    <extensions>
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>1.7.1</version>
      </extension>
    </extensions>
  </build>
</project>
